{
  "hosting": [
    {
      "target": "gitsyn-landing",
      "public": "landing/public",
      "cleanUrls": true,
      "ignore": ["firebase.json", ".git/**", "**/node_modules/**"],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        },
        {
          "source": "images/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
          ]
        }
      ]
    }
  ]
}
